{
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "react-jsx",
    "module": "esnext",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    "outDir": "dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@/*": ["../../packages/client/src/*"]
    }
  },
  "include": ["src", "forge.env.d.ts"]
}
