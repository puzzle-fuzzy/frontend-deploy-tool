# Server Environment Variables

# Server configuration
# Runtime safety mode: development | test | production
# Production also requires two distinct management/deploy origins.
DEPLOYKIT_ENV=development
# Server port (default: 4010)
PORT=4010

# Storage configuration
# SQLite database path (relative to server dir or absolute)
DATABASE_FILE=deploykit.sqlite
# Legacy JSON path. When SQLite is empty, this file is imported once and backed up.
DATA_FILE=data.json
# Path to deployment storage directory (relative to server dir or absolute)
STORAGE_DIR=.voasx/storage
# Path to management UI static files (relative to server dir or absolute)
PUBLIC_DIR=public

# Browser trust zones
# Trusted management UI + API origin (production required)
MANAGEMENT_BASE_URL=
# Untrusted artifact origin (production required and must be different)
DEPLOY_BASE_URL=

# Authentication
# Required in production; use at least 32 random characters.
SESSION_SECRET=
# Seeded only when the user store is empty. Required in production.
ADMIN_EMAIL=admin@deploykit.local
ADMIN_PASSWORD=
# Defaults to true in development/test and false in production.
REGISTRATION_ENABLED=

# Upload limits (in bytes/characters, use defaults if not set)
# Maximum ZIP file size (default: 104857600 = 100MB)
MAX_ZIP_SIZE=104857600
# Maximum extracted size (default: 104857600 = 100MB)
MAX_EXTRACTED_SIZE=104857600
# Maximum number of files (default: 1000)
MAX_FILE_COUNT=1000
# Maximum path length (default: 1000 characters)
MAX_PATH_LENGTH=1000
# Maximum declared compression ratio per ZIP entry (default: 200)
MAX_COMPRESSION_RATIO=200
# Maximum complete multipart request size (default: larger artifact limit + 1MB)
MAX_UPLOAD_REQUEST_SIZE=105906176
# In-process upload concurrency budgets
MAX_CONCURRENT_UPLOADS=4
MAX_CONCURRENT_UPLOADS_PER_USER=2
MAX_CONCURRENT_UPLOADS_PER_PROJECT=1
# Persisted extracted artifact quotas (global / creator account / project)
MAX_STORAGE_SIZE=21474836480
MAX_STORAGE_SIZE_PER_USER=10737418240
MAX_STORAGE_SIZE_PER_PROJECT=5368709120
# Incomplete uploads are retained for 24h; committed trash/orphans for 7 days.
STAGING_RETENTION_HOURS=24
RECOVERY_RETENTION_HOURS=168

# Observability and shutdown
# Prometheus endpoint on the management origin. Defaults true outside production
# and false in production.
METRICS_ENABLED=
# Required (at least 32 characters) when production metrics are enabled.
METRICS_TOKEN=
# Drain timeout for SIGTERM/SIGINT before force-closing (default: 30000ms).
SHUTDOWN_TIMEOUT_MS=30000
